<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (Android 8.0 / API 26+).

    The foreground mark is sized by tool/generate_brand_assets.ps1 to 55.5dp,
    the largest width whose furthest opaque pixel still falls inside the 66dp
    guaranteed-visible circle. Sizing it any wider gets the corners shaved off by
    circular launcher masks. Regenerate the bitmaps rather than editing them.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+). Android tints this layer by its alpha. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>