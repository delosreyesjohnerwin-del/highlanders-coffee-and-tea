<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch splash, API 21+.

    Pinned to white rather than ?android:colorBackground: the app's palette is a
    fixed monochrome white/black and does not follow the system dark-mode setting,
    so resolving the background dynamically would show a black splash immediately
    before the white first frame on dark-mode devices.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <!-- Generated by tool/generate_brand_assets.ps1. Do not hand-edit. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>